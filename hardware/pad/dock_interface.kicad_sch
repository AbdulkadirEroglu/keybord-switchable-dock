	(text "Undocked, a bridge from +5V to RX/TX injects at most about 1.4 mA into the pad Pico."
		(exclude_from_sim no)
		(at 32.004 92.884 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "17123870-5ad0-45a5-9346-3919a104889c")
	)
	(text "Pogo contacts, pad side. Face-to-face mating mirrors the dock order (dock: GND | +5V | DET | RX | TX | GND)."
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2fa63d70-e635-4521-b7ef-09ccc2f23c4c")
	)
	(text "POGO_DTX = dock TX contact (pad receives), POGO_DRX = dock RX contact (pad transmits). DET is tied to GND: that enables the dock TPS2552."
		(exclude_from_sim no)
		(at 20 25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "475b8f10-fe14-4146-be7e-fad253d65686")
	)
	(text "1k series on both sides: 2k total when docked (about 40 ns edge, fine at 1 Mbaud)."
		(exclude_from_sim no)
		(at 32.004 87.884 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "efe1d426-aff0-4bca-b3ae-df91538b9d33")
	)
