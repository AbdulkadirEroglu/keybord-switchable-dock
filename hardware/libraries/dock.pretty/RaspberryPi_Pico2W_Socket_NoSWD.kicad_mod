(footprint "RaspberryPi_Pico2W_Socket_NoSWD"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Raspberry Pi Pico 2 W(H) on 2.54mm 8.5mm female sockets, no spring probes, no SWD holes (pad version: debug through the Pico H/WH's own 3-pin JST connector). D1-D3 and TP1-TP6 are 0.5 mm copper-only placeholders (no holes, not connected) collected in one column (local x 1.5-15.9, y 38.5) where the pad board has free space, so the symbol pins map. Antenna keep-out at the pin 20/21 end.")
