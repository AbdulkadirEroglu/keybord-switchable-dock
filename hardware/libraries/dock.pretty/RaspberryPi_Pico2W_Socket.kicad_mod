(footprint "RaspberryPi_Pico2W_Socket"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Raspberry Pi Pico 2 W(H) on 2.54mm 8.5mm female sockets, no spring probes (pad version). TP1-TP6 are copper-only placeholders (no holes, covered) so the symbol pins map. SWD via a 1x3 socket under the debug holes (SWCLK/GND/SWDIO); antenna keep-out at the bottom end. Positions from Pico 2 W datasheet Figs 3 and 5.")
